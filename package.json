{
  "name": "@adonisjs/content",
  "description": "Content management for AdonisJS with schema validation, GitHub loaders, and custom queries",
  "version": "1.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "main": "build/index.js",
  "exports": {
    "./loaders": "./build/src/loaders/main.js",
    "./types": "./build/src/types.js",
    "./content_provider": "./build/providers/content_provider.js",
    ".": "./build/index.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@adonisjs/vite": "^6.0.0-next.1",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "^26.1.0",
    "@vinejs/vine": "^4.4.0",
    "c8": "^11.0.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "release-it": "^20.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "dayjs": "^1.11.21"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.19",
    "@adonisjs/core": "^7.0.0-next.10",
    "@adonisjs/vite": "^5.1.0-next.1 || ^5.1.1 || ^6.0.0-next.1",
    "@vinejs/vine": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    }
  },
  "homepage": "https://github.com/adonisjs/content#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/content.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/content/issues"
  },
  "keywords": [
    "adonisjs",
    "content",
    "collection",
    "schema",
    "validation",
    "github",
    "sponsors",
    "contributors",
    "releases",
    "cms"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsup": {
    "entry": [
      "index.ts",
      "providers/content_provider.ts",
      "src/loaders/main.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": false,
    "target": "esnext"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
